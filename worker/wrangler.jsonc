{
  "name": "underground-rt",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // The Cache API is a no-op on workers.dev, so the edge cache layer only takes effect
  // on a custom domain/route (tracked in 8x4.5). Until then the per-isolate memo and the
  // upstream cf.cacheTtl are what limit upstream fetches.
  "workers_dev": true,
  // Invocation logs record "Fetch GET <url>", and /geocode's URL carries the user's query, so they
  // are off for the whole Worker. Our own console logs (rt-miss, ene-miss, geocode-miss: counts and
  // fixed codes, never a query) stay on. Never enable observability.traces: they record subrequest URLs.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } }
}
