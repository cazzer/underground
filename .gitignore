node_modules
dist
*.tsbuildinfo
.DS_Store
.env
.env.*
!.env.example
coverage
.claude/worktrees

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# GTFS zips are inputs only, never committed
*.zip

# Half-written catalog files from an interrupted data:catalog:fetch
data/stations/catalog/*.tmp
# Half-written street pin files from an interrupted data:streets:fetch
data/streets/*.tmp

# Dated planned-work timetables are built by each Pages deploy (npm run data:dated), never committed
public/data/timetable/dated/

# The NYC basemap is built by basemap.yml and fetched by npm run basemap:fetch, never committed
public/basemap/
*.pmtiles
